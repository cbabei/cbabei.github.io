---
// Wild rabbit, side view facing right.
---

<svg class="rabbit-svg" viewBox="0 -6 60 54" aria-hidden="true" focusable="false">
  <ellipse cx="38" cy="6" rx="3.2" ry="11" transform="rotate(-24 38 6)" class="fur-dark" />
  <ellipse cx="26" cy="32" rx="17" ry="12" class="fur" />
  <ellipse cx="18" cy="35" rx="11" ry="10" class="fur-dark" />
  <circle cx="8" cy="29" r="5" class="tail" />
  <ellipse cx="40" cy="42" rx="5" ry="2.6" class="fur-dark" />
  <circle cx="44" cy="22" r="9.5" class="fur" />
  <ellipse cx="42" cy="5" rx="3.6" ry="11.5" transform="rotate(-14 42 5)" class="fur" />
  <ellipse cx="42" cy="6" rx="1.6" ry="8" transform="rotate(-14 42 6)" class="ear-in" />
  <circle cx="47.5" cy="20" r="1.8" class="eye" />
  <circle cx="53" cy="23.5" r="1.3" class="nose" />
</svg>

<style>
  .rabbit-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .fur {
    fill: #9a8064;
  }
  .fur-dark {
    fill: #7d6550;
  }
  .tail {
    fill: #f7f3ec;
  }
  .ear-in {
    fill: #d9a594;
  }
  .eye {
    fill: #1d1612;
  }
  .nose {
    fill: #c98a86;
  }
</style>
