---
import { type Lang, useTranslations } from '../i18n/ui';
import { strengths, type Strength } from '../data/extras';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Same gradient tiles as the certifications, one colour per CliftonStrengths domain.
const domains: Record<Strength['domain'], { from: string; to: string }> = {
  executing: { from: '#9b6cf8', to: '#5b34c7' },
  strategic: { from: '#22c3b0', to: '#0e7f73' },
  relationship: { from: '#3b8cf0', to: '#1b4fa8' },
};
---

<section id="strengths" aria-labelledby="strengths-title" class="container-page py-12 md:py-16">
  <div class="reveal">
    <h2 id="strengths-title" class="section-title">{t('strengths.title')}</h2>
    <p class="mt-3 text-muted">{t('strengths.lead')}</p>
    <ul class="legend">
      {
        Object.entries(domains).map(([d, c]) => (
          <li style={`--from:${c.from};--to:${c.to}`}>{t(`strengths.${d as Strength['domain']}`)}</li>
        ))
      }
    </ul>
  </div>

  {/* Each card shows its text on hover (mouse) or when tapped / opened with the keyboard. */}
  <ol class="strength-grid" data-strengths>
    {
      strengths.map((s, i) => {
        const c = domains[s.domain];
        return (
          <li class="strength reveal" style={`--from:${c.from};--to:${c.to}`}>
            <button type="button" class="strength-face card" aria-expanded="false" aria-describedby={`strength-${i}`}>
              <span class="strength-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="strength-icon">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="strength-name">{s.name[lang]}</span>
            </button>
            <p id={`strength-${i}`} class="strength-text">
              <span class="strength-text-name" aria-hidden="true">
                {s.name[lang]}
              </span>
              {s.text[lang]}
            </p>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .legend {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .legend li::before {
    content: '';
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 0.2rem;
    background: linear-gradient(135deg, var(--from), var(--to));
  }

  .strength-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .strength-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .strength {
    position: relative;
  }
  .strength-face {
    position: relative;
    width: 100%;
    min-height: 12.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.4, 1.4), border-color 0.3s;
  }
  .strength-num {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .strength-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    color: #fff;
    background: linear-gradient(135deg, var(--from), var(--to));
    box-shadow: 0 8px 16px -8px var(--to);
    transition: rotate 0.5s cubic-bezier(0.3, 0.7, 0.4, 1.6);
  }
  .strength-name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  /* The text: laid over the card, hidden until hover (mouse), tap (.is-open) or keyboard focus. */
  .strength-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem;
    overflow: auto;
    border-radius: 1.25rem;
    border: 1px solid var(--to);
    background: var(--surface-strong);
    color: var(--fg);
    font-size: 0.85rem;
    line-height: 1.5;
    opacity: 0;
    translate: 0 0.5rem;
    pointer-events: none;
    transition: opacity 0.25s, translate 0.25s;
  }
  .strength-text-name {
    font-weight: 700;
    color: var(--to);
  }
  :global(:root[data-theme='dark']) .strength-text-name {
    color: var(--from);
  }
  .strength.is-open .strength-text,
  .strength:has(.strength-face:focus-visible) .strength-text {
    opacity: 1;
    translate: 0 0;
  }
  @media (hover: hover) {
    .strength:hover .strength-text {
      opacity: 1;
      translate: 0 0;
    }
    .strength:hover .strength-icon {
      rotate: -8deg;
    }
  }
  .strength-face:focus-visible {
    outline-offset: 3px;
  }

  /* Phones and tablets: cards are too narrow for the text, so each strength is a row that unfolds it below. */
  @media (max-width: 1023px) {
    .strength-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
    .strength-face {
      min-height: 0;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 0.9rem;
      padding: 0.75rem 1rem;
    }
    .strength-num {
      position: static;
      order: 3;
      margin-left: auto;
    }
    .strength-icon {
      flex: none;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.75rem;
    }
    .strength-text {
      position: static;
      display: none;
      margin-top: 0.4rem;
      padding: 0.9rem 1rem;
      opacity: 1;
      translate: none;
      border-radius: 1rem;
    }
    .strength-text-name {
      display: none;
    }
    .strength.is-open .strength-text {
      display: block;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .strength-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>

<script>
  // Tap or Enter opens a card's text (and closes the others); tapping it again closes it.
  const grid = document.querySelector('[data-strengths]');
  grid?.addEventListener('click', (e) => {
    const card = (e.target as Element).closest('.strength');
    if (!card) return;
    const open = !card.classList.contains('is-open');
    grid.querySelectorAll('.strength.is-open').forEach((c) => {
      c.classList.remove('is-open');
      c.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
    card.classList.toggle('is-open', open);
    card.querySelector('button')?.setAttribute('aria-expanded', String(open));
  });
</script>
