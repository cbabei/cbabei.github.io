---
import { type Lang, useTranslations } from '../i18n/ui';
import { certifications, type Certification } from '../data/extras';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const look: Record<Certification['category'], { from: string; to: string; icon: string }> = {
  dev: { from: '#3b8cf0', to: '#1b4fa8', icon: '<path d="m9 8-5 4 5 4M15 8l5 4-5 4"/>' },
  integration: { from: '#9b6cf8', to: '#5b34c7', icon: '<path d="M4 9h14l-3.5-3.5M20 15H6l3.5 3.5"/>' },
  admin: {
    from: '#22c3b0',
    to: '#0e7f73',
    icon: '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/>',
  },
  ai: {
    from: '#f062a8',
    to: '#b02a6f',
    icon: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 3v4M17 5h4M5 17v4M3 19h4"/>',
  },
  ux: {
    from: '#f8b13a',
    to: '#c2690a',
    icon: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/>',
  },
};
---

<section id="certifications" aria-labelledby="cert-title" class="container-page py-12 md:py-16">
  <div class="reveal">
    <h2 id="cert-title" class="section-title">{t('cert.title')}</h2>
    <p class="mt-3 text-muted">{t('cert.lead')}</p>
  </div>

  <ul class="cert-grid">
    {
      certifications.map((c, i) => {
        const l = look[c.category];
        return (
          <li class="cert card reveal">
            <div class="cert-side">
            <svg class="cert-badge" viewBox="0 0 64 72" aria-hidden="true">
              <defs>
                <linearGradient id={`cert-g${i}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color={l.from} />
                  <stop offset="1" stop-color={l.to} />
                </linearGradient>
              </defs>
              <path d="M32 2 60 18v36L32 70 4 54V18z" fill={`url(#cert-g${i})`} />
              <path d="M32 8.5 54.5 21.5v29L32 63.5 9.5 50.5v-29z" fill="none" stroke="#fff" stroke-opacity=".3" stroke-width="1.2" />
              <g
                transform="translate(18 22) scale(1.17)"
                fill="none"
                stroke="#fff"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={l.icon}
              />
            </svg>
              <span class="cert-year">
                <span class="sr-only">{t('cert.issued')} </span>
                {c.year}
              </span>
              <a class="cert-link" href={c.credly} target="_blank" rel="noopener" aria-label={`${t('cert.verify')}: ${c.short}`}>
                Credly
                <Icon name="external" size={12} />
              </a>
            </div>
            <div class="min-w-0">
              <p class="font-mono text-[0.7rem] uppercase tracking-widest text-muted">SAP · {c.area[lang]}</p>
              <h3 class="mt-1 text-lg font-bold leading-snug">{c.short}</h3>
              <p class="mt-1 text-sm text-muted">{c.name}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .cert-grid {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .cert-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .cert-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cert {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.4, 1.4), border-color 0.3s;
  }
  .cert::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.35) 50%, transparent 65%);
    translate: -110% 0;
    pointer-events: none;
  }
  .cert:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .cert:hover::after {
    translate: 110% 0;
    transition: translate 0.9s ease;
  }
  .cert-side {
    flex: none;
    width: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .cert-badge {
    width: 3.4rem;
    height: auto;
    filter: drop-shadow(0 6px 10px var(--shadow));
    transition: rotate 0.5s cubic-bezier(0.3, 0.7, 0.4, 1.6);
  }
  .cert:hover .cert-badge {
    rotate: -8deg;
  }
  .cert-year {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .cert-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .cert-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
