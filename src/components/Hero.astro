---
import { type Lang, localePath, useTranslations } from '../i18n/ui';
import { profile, site } from '../data/profile';
import Portrait from './Portrait.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
 <div class="container-page hero-inner">
  {/* The sun travels along an arc to the right and becomes the moon. Driven by --p (see global.css). */}
  <div class="track">
    <button
      type="button"
      class="celestial"
      data-theme-toggle
      data-label-light={t('theme.sun')}
      data-label-dark={t('theme.moon')}
      aria-label={t('theme.sun')}
      aria-pressed="false"
    >
      <span class="orb">
        <span class="rays"></span>
        <span class="sun"></span>
        <span class="moon"></span>
      </span>
      <span class="hint hint-day" aria-hidden="true">← {t('theme.hint')}</span>
      <span class="hint hint-night" aria-hidden="true">{t('theme.hint')} →</span>
    </button>
  </div>

  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t('hero.greeting')}</p>
      <h1 id="hero-title" class="hero-name">{site.name}</h1>
      <p class="hero-role">{profile.role[lang]}</p>
      <p class="hero-tagline">{profile.tagline[lang]}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={site.linkedin} rel="me noopener" target="_blank">
          <Icon name="linkedin" size={17} />
          {t('hero.cta.linkedin')}
        </a>
        <a class="btn btn-ghost" href={localePath(lang, 'about')}>
          {t('hero.cta.story')}
          <Icon name="arrow-right" size={17} />
        </a>
      </div>

      <dl class="stats">
        {
          profile.stats.map((s) => (
            <div>
              <dt>{s.label[lang]}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-avatar">
      <div class="avatar-halo" aria-hidden="true"></div>
      <Portrait />
    </div>
  </div>
 </div>
</section>

<style>
  .hero {
    /* Full width so the sun/moon glow is only clipped by the screen edge, never by the content column. */
    overflow-x: clip;
  }
  .hero-inner {
    position: relative;
    padding-top: 7.5rem;
    padding-bottom: 1rem;
    min-height: min(calc(100svh - 6rem), 44rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .track {
    --size: 4.25rem;
    --arc: 2.75rem;
    position: absolute;
    top: 2.75rem;
    left: 1.25rem;
    right: 1.25rem;
    height: var(--size);
    container-type: inline-size;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .hero-inner {
      padding-top: 9.5rem;
    }
    .track {
      --size: 5.5rem;
      --arc: 3.5rem;
      left: 2rem;
      right: 2rem;
    }
  }

  .celestial {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    translate: calc(var(--p) * (100cqw - var(--size))) calc(sin(var(--p) * 180deg) * -1 * var(--arc));
    scale: calc(1 - var(--p) * 0.25);
    -webkit-tap-highlight-color: transparent;
  }
  .celestial:focus-visible {
    outline-offset: 8px;
    border-radius: 50%;
  }

  .orb {
    position: absolute;
    inset: 0;
    display: block;
    animation: float 6s ease-in-out infinite;
    transition: transform 0.4s cubic-bezier(0.3, 0.7, 0.4, 1.5);
  }
  .celestial:hover .orb {
    transform: scale(1.08);
  }
  .celestial:active .orb {
    transform: scale(0.94);
  }
  @keyframes float {
    50% {
      translate: 0 -5px;
    }
  }

  .sun,
  .moon,
  .rays {
    position: absolute;
    border-radius: 50%;
  }
  .sun {
    inset: 0;
    opacity: calc(1 - var(--p));
    background: radial-gradient(circle at 35% 32%, #fff6c9, #ffd23f 45%, #ff9f1c);
    box-shadow:
      0 0 36px 8px rgb(255 190 60 / 0.55),
      0 0 120px 36px rgb(255 170 40 / 0.22);
  }
  .rays {
    inset: -45%;
    opacity: calc((1 - var(--p)) * 0.9);
    background: repeating-conic-gradient(from 0deg, rgb(255 200 80 / 0.45) 0deg 5deg, transparent 5deg 22.5deg);
    mask: radial-gradient(circle, transparent 36%, #000 38%, transparent 68%);
    animation: spin 50s linear infinite;
  }
  .celestial:hover .rays {
    animation-duration: 12s;
  }
  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
  .moon {
    inset: 0;
    opacity: var(--p);
    background:
      radial-gradient(circle at 30% 62%, rgb(150 165 190 / 0.55) 0 9%, transparent 10%),
      radial-gradient(circle at 62% 35%, rgb(150 165 190 / 0.45) 0 12%, transparent 13%),
      radial-gradient(circle at 68% 70%, rgb(150 165 190 / 0.4) 0 6%, transparent 7%),
      radial-gradient(circle at 38% 30%, #fbfcf5, #dfe5ee 55%, #b5c0d2);
    box-shadow:
      0 0 30px 6px rgb(200 220 255 / 0.35),
      0 0 100px 30px rgb(140 180 255 / 0.14);
  }

  .hint {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .hint-day {
    left: calc(100% + 1rem);
    opacity: calc(1 - var(--p) * 3);
    animation: nudge-left 2.4s ease-in-out infinite;
  }
  .hint-night {
    right: calc(100% + 1rem);
    opacity: calc(var(--p) * 3 - 2);
    animation: nudge-right 2.4s ease-in-out infinite;
  }
  :global(:root[data-theme='dark']) .hint-day,
  :global(:root[data-theme='light']) .hint-night,
  :global(.theme-touched) .hint {
    visibility: hidden;
  }
  @keyframes nudge-left {
    50% {
      translate: -4px -50%;
    }
  }
  @keyframes nudge-right {
    50% {
      translate: 4px -50%;
    }
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .hero-name {
    margin-top: 0.5rem;
    font-size: clamp(2.9rem, 9vw, 5.75rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .hero-role {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2.2vw, 1.15rem);
    font-weight: 600;
    background: linear-gradient(90deg, var(--accent), color-mix(in oklab, var(--accent), var(--fg) 45%), var(--accent));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 8s linear infinite;
  }
  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }
  .hero-tagline {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
  }

  .stats {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 30rem;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--line);
  }
  .stats dd {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--fg);
  }
  .stats dt {
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .hero-avatar {
    position: relative;
    width: min(100%, 17rem);
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .hero-avatar {
      width: min(100%, 24rem);
      margin-top: 3rem;
    }
  }
  .avatar-halo {
    position: absolute;
    inset: 8% 4% 0;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft), transparent 70%);
    filter: blur(8px);
  }
</style>
