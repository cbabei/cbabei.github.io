---
import { type Lang, useTranslations } from '../i18n/ui';
import { featuredQuote, recommendations, type Recommendation } from '../data/extras';
import { site } from '../data/profile';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const linkedin = `${site.linkedin}/details/recommendations/`;
const translated = (r: Recommendation) => r.original !== lang;
---

<section id="recommendations" aria-labelledby="reco-title" class="container-page py-12 md:py-16">
  <div class="reveal">
    <h2 id="reco-title" class="section-title">{t('reco.title')}</h2>
    <p class="mt-3 text-muted">{t('reco.lead')} {t('reco.featured')}</p>
  </div>

  <figure class="featured reveal">
    <blockquote>
      <p>“{featuredQuote.quote[lang]}”</p>
    </blockquote>
    {translated(featuredQuote) && <p class="translated">({t('reco.translated')})</p>}
    <figcaption>
      {featuredQuote.role[lang]} · {featuredQuote.relation[lang]} · {featuredQuote.year}
    </figcaption>
  </figure>

  <ul class="reco-grid">
    {
      recommendations.map((r) => (
        <li class="reveal">
          <figure class="reco card">
            <div class="reco-top">
              <svg class="quote-mark" viewBox="0 0 32 24" aria-hidden="true">
                <path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h6v12zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h6v12z" />
              </svg>
              {translated(r) && <p class="translated">({t('reco.translated')})</p>}
            </div>
            <blockquote class="mt-3 mb-5 leading-relaxed">
              <p>{r.quote[lang]}</p>
            </blockquote>
            <figcaption class="reco-by">
              <span class="block font-semibold">{r.role[lang]}</span>
              <span class="block text-sm text-muted">
                {r.relation[lang]} · {r.year}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 flex justify-center">
    <a class="btn btn-primary" href={linkedin} target="_blank" rel="noopener">
      <Icon name="linkedin" size={17} />
      {t('reco.more')}
      <Icon name="external" size={15} />
    </a>
  </div>
</section>

<style>
  /* The quote that sums him up: centred, with who said it aligned to the right under it. */
  .featured {
    max-width: 52rem;
    margin: 1.25rem auto 0;
    text-align: center;
  }
  .featured blockquote {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.15;
    background: linear-gradient(90deg, var(--fg), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .featured figcaption {
    margin-top: 1rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Cards of equal height, with the author always at the bottom. */
  .reco-grid {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .reco-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .reco-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .reco {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    font-size: 0.95rem;
    /* Even line lengths, and never a single word left alone on the last line. */
    text-wrap: pretty;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.4, 1.4), border-color 0.3s;
  }
  .reco:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .quote-mark {
    width: 1.75rem;
    fill: var(--accent);
    opacity: 0.85;
  }
  /* Author block always in the same place and format: right-aligned under a hairline. */
  .reco-by {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    text-align: right;
  }
  /* Quote mark on the left; when the text is a translation, a small note on the right. */
  .reco-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .reco-top .translated {
    margin-top: 0;
    text-align: right;
  }
  .translated {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.85;
  }
</style>
