---
import { type Lang, type UIKey, formatMonth, useTranslations } from '../i18n/ui';
import { focusAreas, jobs } from '../data/experience';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// ---- Career map (built at compile time) ----
const now = new Date();
const nowIdx = now.getUTCFullYear() * 12 + now.getUTCMonth();
const toIdx = (ym: string | null) => {
  if (!ym) return nowIdx + 1;
  const [y, m] = ym.split('-').map(Number);
  return y * 12 + (m - 1);
};
const firstYear = Math.min(...jobs.map((j) => Number(j.start.slice(0, 4))));
const lastYear = now.getUTCFullYear() + 1;
const min = firstYear * 12;
const span = lastYear * 12 - min;
const pct = (idx: number) => ((idx - min) / span) * 100;

const lanes: number[] = [];
const bars = [...jobs]
  .sort((a, b) => toIdx(a.start) - toIdx(b.start))
  .map((j) => {
    const s = toIdx(j.start);
    const e = toIdx(j.end);
    let lane = lanes.findIndex((end) => end <= s);
    if (lane === -1) lane = lanes.push(e) - 1;
    else lanes[lane] = e;
    return { job: j, lane, left: pct(s), width: Math.max(pct(e) - pct(s), 1.2) };
  });
const years = Array.from({ length: lastYear - firstYear }, (_, i) => firstYear + i);

const usedFocus = focusAreas.filter((f) => jobs.some((j) => j.focus.includes(f)));
const typeOptions = [
  { value: '', label: t('exp.filter.all') },
  { value: 'employee', label: t('exp.employee') },
  { value: 'freelance', label: t('exp.freelance') },
];
const focusOptions = [
  { value: '', label: t('exp.filter.all') },
  ...usedFocus.map((f) => ({ value: f, label: t(`focus.${f}` as UIKey) })),
];

function duration(start: string, end: string | null) {
  const months = toIdx(end) - toIdx(start) + (end ? 1 : 0);
  const y = Math.floor(months / 12);
  const m = months % 12;
  const parts =
    lang === 'es'
      ? [y && `${y} ${y > 1 ? 'años' : 'año'}`, m && `${m} ${m > 1 ? 'meses' : 'mes'}`]
      : [y && `${y} ${y > 1 ? 'yrs' : 'yr'}`, m && `${m} ${m > 1 ? 'mos' : 'mo'}`];
  return parts.filter(Boolean).join(' ');
}
---

<section id="experience" aria-labelledby="exp-title" class="experience">
  <h2 id="exp-title" class="section-title">{t('exp.title')}</h2>
  <p class="mt-3 text-muted">{t('exp.lead')}</p>

  <figure class="career-map card">
    <figcaption class="map-caption">
      <span>{t('exp.map')}</span>
      <span class="legend" aria-hidden="true">
        <span class="legend-item"><i class="swatch swatch--employee"></i>{t('exp.employee')}</span>
        <span class="legend-item"><i class="swatch swatch--freelance"></i>{t('exp.freelance')}</span>
      </span>
    </figcaption>
    {/* Visual summary only: the list below carries the real content. */}
    <div class="map-scroll" role="region" tabindex="0" aria-label={`${t('exp.map')} – ${t('exp.map.hint')}`} data-map-scroll>
      <div class="map-inner" style={`--years:${years.length};--lanes:${lanes.length}`} aria-hidden="true">
        <div class="map-body">
          {years.map((y) => <span class="year-line" style={`left:${pct(y * 12)}%`} />)}
          {
            bars.map((b) => (
              <a
                href={`#job-${b.job.id}`}
                tabindex="-1"
                draggable="false"
                class={`bar bar--${b.job.engagement}`}
                data-job={b.job.id}
                data-type={b.job.engagement}
                data-focus={b.job.focus.join('|')}
                style={`left:${b.left}%;width:${b.width}%;--lane:${b.lane}`}
                title={`${b.job.company} · ${formatMonth(b.job.start, lang)} – ${b.job.end ? formatMonth(b.job.end, lang) : t('exp.present')}`}
              >
                <span>{b.job.company}</span>
              </a>
            ))
          }
        </div>
        <div class="map-axis">
          {years.map((y) => <span style={`left:${pct(y * 12)}%`}>{y}</span>)}
        </div>
      </div>
    </div>
  </figure>

  <div class="filters" role="group" aria-label={t('exp.filter')}>
    <div class="filter-row">
      <span class="filter-label" id="filter-type">{t('exp.filter.type')}</span>
      <div class="filter-chips" role="group" aria-labelledby="filter-type">
        {
          typeOptions.map((o) => (
            <button type="button" class="chip" data-group="type" data-value={o.value} aria-pressed={o.value === '' ? 'true' : 'false'} aria-controls="job-list">
              {o.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="filter-row">
      <span class="filter-label" id="filter-focus">{t('exp.filter.focus')}</span>
      <div class="filter-chips" role="group" aria-labelledby="filter-focus">
        {
          focusOptions.map((o) => (
            <button type="button" class="chip" data-group="focus" data-value={o.value} aria-pressed={o.value === '' ? 'true' : 'false'} aria-controls="job-list">
              {o.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>
  <p class="showing" aria-live="polite" data-template={t('exp.showing')} data-total={jobs.length}></p>

  <ol id="job-list" class="jobs">
    {
      jobs.map((j) => (
        <li
          id={`job-${j.id}`}
          class="job"
          data-job={j.id}
          data-type={j.engagement}
          data-focus={j.focus.join('|')}
          style={`view-transition-name:job-${j.id}`}
        >
          <article class="job-card">
            <p class="job-dates">
              <time datetime={j.start}>{formatMonth(j.start, lang)}</time>
              <span class="job-span">
                <span class="sr-only"> – </span>
                <span class="job-duration">{duration(j.start, j.end)}</span>
                <span class="job-arrow" aria-hidden="true"></span>
              </span>
              {j.end ? <time datetime={j.end}>{formatMonth(j.end, lang)}</time> : <span class="now">{t('exp.present')}</span>}
            </p>
            <div>
              <h3 class="job-title">
                <span class="job-role">{j.role[lang]}</span>
                <span class="job-company"> · {j.company}</span>
              </h3>
              <p class="job-meta">
                {j.location[lang]}
                <span class={`badge badge--${j.engagement}`}>{t(`exp.${j.engagement}`)}</span>
              </p>
              <ul class="job-highlights">
                {j.highlights[lang].map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <ul class="job-tech" aria-label="Tech">
                {j.tech.map((x) => (
                  <li class="chip">{x}</li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import '../scripts/experience';
</script>

<style>
  @media (min-width: 1024px) {
    /* Line the heading up with "About", whose card has 2rem padding + 1px border. */
    .experience {
      padding-top: calc(2rem + 1px);
    }
  }

  .career-map {
    margin-top: 1.75rem;
    padding: 1rem 0 0.5rem;
    overflow: hidden;
  }
  .map-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-inline: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .legend {
    display: flex;
    gap: 0.9rem;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 0.9rem;
    height: 0.5rem;
    border-radius: 3px;
  }

  .map-scroll {
    margin-top: 0.85rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    cursor: grab;
    mask-image: linear-gradient(to right, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent);
  }
  .map-scroll.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .map-inner {
    width: max(100%, calc(var(--years) * 6.5rem));
    padding-inline: 1.25rem;
  }
  .map-body {
    --bar-h: 1.7rem;
    --gap: 0.4rem;
    position: relative;
    height: calc(var(--lanes) * (var(--bar-h) + var(--gap)));
  }
  .year-line {
    position: absolute;
    top: -0.25rem;
    bottom: -0.25rem;
    width: 1px;
    background: var(--line);
  }
  .bar {
    position: absolute;
    top: calc(var(--lane) * (var(--bar-h) + var(--gap)));
    height: var(--bar-h);
    display: flex;
    align-items: center;
    /* clip (not hidden) so the sticky label below follows the map's own scroll. */
    overflow: clip;
    padding-inline: 0.5rem;
    border-radius: 0.45rem;
    color: var(--bg);
    font-size: 0.74rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transform-origin: left;
    transition: opacity 0.3s, filter 0.3s, transform 0.3s;
    -webkit-user-drag: none;
  }
  .bar span {
    position: sticky;
    left: 1.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .swatch--employee,
  .bar--employee {
    background: var(--accent);
  }
  .swatch--freelance,
  .bar--freelance {
    background: repeating-linear-gradient(
      -45deg,
      var(--accent) 0 6px,
      color-mix(in oklab, var(--accent) 72%, var(--bg)) 6px 12px
    );
  }
  .bar:hover,
  .bar.is-linked {
    transform: scaleY(1.15);
    filter: brightness(1.12);
  }
  .bar.is-dim {
    opacity: 0.15;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar {
      animation: grow 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--lane) * 80ms);
    }
  }
  @keyframes grow {
    from {
      clip-path: inset(0 100% 0 0 round 0.45rem);
    }
  }
  .map-axis {
    position: relative;
    height: 1.6rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .map-axis span {
    position: absolute;
    padding-left: 0.3rem;
  }

  .filters {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .filter-row {
    display: grid;
    gap: 0.4rem;
  }
  @media (min-width: 640px) {
    .filter-row {
      grid-template-columns: 4.5rem 1fr;
      align-items: baseline;
    }
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .showing {
    margin-top: 0.75rem;
    min-height: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .jobs {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .job[hidden] {
    display: none;
  }
  .job-card {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s, opacity 0.3s;
  }
  @media (min-width: 640px) {
    .job-card {
      grid-template-columns: 6.25rem minmax(0, 1fr);
    }
  }
  .job-card:hover,
  .job.is-linked .job-card {
    background: var(--surface);
    border-color: var(--line);
    box-shadow: 0 12px 32px -16px var(--shadow);
  }
  @media (pointer: fine) {
    .jobs:hover .job:not(:hover):not(.is-linked) .job-card {
      opacity: 0.6;
    }
  }
  /* Start ↓ duration ↓ end, centred in a narrow column (one line on phones). */
  .job-dates {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  /* Start and end are what matters; the duration in between stays quiet. */
  .job-dates time,
  .job-dates .now {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--fg);
  }
  .job-dates .now {
    color: var(--accent);
  }
  .job-span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  /* A real arrow: shaft above the duration, shaft + head below it (or left/right on phones). */
  .job-span::before,
  .job-arrow {
    content: '';
    position: relative;
    width: 0.9rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .job-arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.4rem;
    height: 0.4rem;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    translate: 0 -50%;
    rotate: 45deg;
  }
  .job-duration {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0.75;
  }
  @media (min-width: 640px) {
    .job-dates {
      flex-direction: column;
      gap: 0.35rem;
      padding-top: 0.15rem;
      text-align: center;
    }
    .job-span {
      flex-direction: column;
      gap: 0.3rem;
    }
    .job-span::before,
    .job-arrow {
      width: 1px;
      height: 0.8rem;
    }
    .job-arrow::after {
      top: auto;
      right: auto;
      bottom: 0;
      left: 50%;
      border-top: 0;
      border-bottom: 1px solid currentColor;
      translate: -50% 0;
    }
  }
  .job-title {
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.35;
  }
  .job-company {
    color: var(--accent);
  }
  .job-meta {
    margin-top: 0.2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .badge--employee {
    background: var(--accent);
    color: var(--bg);
  }
  .job-highlights {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.45rem;
    font-size: 0.93rem;
    color: var(--muted);
  }
  .job-highlights li {
    position: relative;
    padding-left: 1.1rem;
  }
  .job-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 2px;
    rotate: 45deg;
    background: var(--accent);
    opacity: 0.7;
  }
  .job-tech {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
