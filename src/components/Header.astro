---
import { type Lang, languages, localePath, useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  page: string;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const langs = Object.keys(languages) as Lang[];
const onHome = page === '';
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);

// Sections of the home page, then the story, which is a page of its own (set apart by a divider).
const sections = [
  { href: anchor('about'), label: t('nav.about') },
  { href: anchor('experience'), label: t('nav.experience') },
  { href: anchor('certifications'), label: t('nav.certifications') },
  { href: anchor('recommendations'), label: t('nav.recommendations') },
  { href: anchor('beyond'), label: t('nav.beyond') },
];
const story = { href: localePath(lang, 'about'), label: t('nav.story'), current: page === 'about' };
---

<header class="site-header">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="monogram" aria-label={`CB · Cristian Babei – ${t('nav.home')}`}>
      <span aria-hidden="true">CB</span>
    </a>

    <nav aria-label={t('nav.primary')} class="hidden lg:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {
          sections.map((l) => (
            <li>
              <a href={l.href} class="nav-link">
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="nav-sep" aria-hidden="true"></li>
        <li>
          <a href={story.href} class="nav-link" aria-current={story.current ? 'page' : undefined}>
            {story.label}
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {/* Smaller screens: the same links in a dropdown, so the header never crowds. */}
      <button
        type="button"
        class="icon-btn menu-btn"
        popovertarget="mobile-nav"
        aria-label={t('nav.menu')}
        title={t('nav.menu')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
      <nav id="mobile-nav" popover aria-label={t('nav.primary')} class="mobile-nav">
        <ul>
          {
            sections.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li class="mobile-sep" aria-hidden="true"></li>
          <li>
            <a href={story.href} aria-current={story.current ? 'page' : undefined}>
              {story.label}
            </a>
          </li>
        </ul>
      </nav>
      {/* Shows the language you are reading; the menu lists every language to switch to. */}
      <button
        type="button"
        class="icon-btn lang-btn gap-1.5 pl-3 pr-2.5 font-mono text-xs uppercase"
        popovertarget="lang-menu"
        aria-label={`${t('lang.label')}: ${lang.toUpperCase()} – ${languages[lang]}`}
        title={t('lang.label')}
      >
        <Icon name="globe" size={16} />
        {lang}
        <Icon name="chevron-down" size={14} class="lang-chevron" />
      </button>
      <div id="lang-menu" popover class="lang-menu">
        <ul>
          {
            langs.map((code) => (
              <li>
                <a
                  href={localePath(code, page)}
                  hreflang={code}
                  lang={code}
                  aria-current={code === lang ? 'true' : undefined}
                  data-lang-switch={code === lang ? undefined : true}
                >
                  <span class="lang-code">{code}</span>
                  {languages[code]}
                  {code === lang && <Icon name="check" size={16} class="lang-check" />}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <button
        type="button"
        class="icon-btn theme-btn"
        data-theme-toggle
        data-label-light={t('theme.toDark')}
        data-label-dark={t('theme.toLight')}
        aria-label={t('theme.toDark')}
        aria-pressed="false"
      >
        <Icon name="sun" class="i-sun" />
        <Icon name="moon" class="i-moon" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 60%, transparent);
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    transition: transform 0.3s cubic-bezier(0.3, 0.7, 0.4, 1.5), background-color 0.3s, color 0.3s;
  }
  .monogram:hover {
    transform: rotate(-6deg) scale(1.06);
    background: var(--accent);
    color: var(--bg);
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.3s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--fg);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    scale: 1 1;
  }

  .nav-sep {
    width: 1.5px;
    height: 1.25rem;
    border-radius: 1px;
    background: color-mix(in oklab, var(--muted) 55%, transparent);
  }

  @media (min-width: 1024px) {
    .icon-btn.menu-btn,
    .mobile-nav {
      display: none;
    }
  }

  .mobile-nav,
  .lang-menu {
    position: fixed;
    inset: 4.5rem 1rem auto auto;
    margin: 0;
    min-width: 13rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.45);
  }
  .lang-menu {
    min-width: 11rem;
  }
  .mobile-nav a,
  .lang-menu a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--fg);
  }
  .mobile-nav a:hover,
  .mobile-nav a[aria-current='page'],
  .lang-menu a:hover,
  .lang-menu a[aria-current] {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .lang-menu a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .lang-code {
    width: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lang-menu a[aria-current] .lang-code {
    color: inherit;
  }
  .lang-menu :global(.lang-check) {
    margin-left: auto;
  }
  .lang-btn :global(.lang-chevron) {
    transition: rotate 0.25s;
  }
  .lang-btn:has(+ .lang-menu:popover-open) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .lang-btn:has(+ .lang-menu:popover-open) :global(.lang-chevron) {
    rotate: 180deg;
  }
  .mobile-sep {
    height: 1px;
    margin: 0.35rem 0.5rem;
    background: var(--line);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-btn {
    position: relative;
    overflow: hidden;
  }
  .theme-btn :global(svg) {
    position: absolute;
    transition: transform 0.6s cubic-bezier(0.5, 0, 0.2, 1), opacity 0.4s;
  }
  .theme-btn :global(.i-moon) {
    transform: translateY(calc((1 - var(--p)) * 140%)) rotate(calc((1 - var(--p)) * 90deg));
    opacity: var(--p);
  }
  .theme-btn :global(.i-sun) {
    transform: translateY(calc(var(--p) * -140%)) rotate(calc(var(--p) * 90deg));
    opacity: calc(1 - var(--p));
  }
</style>

<script>
  // Following a link inside a dropdown should also close it; picking the language already shown just closes it.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('#mobile-nav a, #lang-menu a');
    if (!link) return;
    if (link.closest('#lang-menu') && link.hasAttribute('aria-current')) e.preventDefault();
    link.closest<HTMLElement>('[popover]')?.hidePopover();
  });

  // Open the language menu right under its button, wherever the header places it.
  const langMenu = document.getElementById('lang-menu');
  const langBtn = document.querySelector<HTMLElement>('[popovertarget="lang-menu"]');
  langMenu?.addEventListener('beforetoggle', (e) => {
    if ((e as ToggleEvent).newState !== 'open' || !langBtn) return;
    const r = langBtn.getBoundingClientRect();
    langMenu.style.top = `${r.bottom + 8}px`;
    langMenu.style.right = `${document.documentElement.clientWidth - r.right}px`;
  });
</script>
