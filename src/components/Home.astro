---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Certifications from './Certifications.astro';
import Recommendations from './Recommendations.astro';
import Strengths from './Strengths.astro';
import Beyond from './Beyond.astro';
import { type Lang, useTranslations } from '../i18n/ui';
import { profileSchema } from '../data/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const title = t('meta.title');
const description = t('meta.description');
---

<Base lang={lang} page="" title={title} description={description} jsonLd={await profileSchema(lang, '', title, description)}>
  <Hero lang={lang} />

  <div class="container-page panels pt-8 pb-12 md:pt-12 md:pb-16">
    <div class="self-stretch"><About lang={lang} /></div>
    <Experience lang={lang} />
  </div>

  <div class="container-page"><hr class="section-divider" /></div>
  <Certifications lang={lang} />
  <div class="container-page"><hr class="section-divider" /></div>
  <Recommendations lang={lang} />
  <div class="container-page"><hr class="section-divider" /></div>
  <Strengths lang={lang} />
  <div class="container-page"><hr class="section-divider" /></div>
  <Beyond lang={lang} />
</Base>

<style>
  .panels {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .panels {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }
</style>
