---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import photo from '../assets/portrait/cristian.png';
import Icon from './Icon.astro';
import { type Lang, localePath, useTranslations } from '../i18n/ui';
import { profileSchema } from '../data/schema';
import { site } from '../data/profile';
import * as en from '../data/story/en.md';
import * as es from '../data/story/es.md';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const title = t('meta.story.title');
const description = t('meta.story.description');
const { Content } = lang === 'es' ? es : en;
---

<Base lang={lang} page="about" title={title} description={description} jsonLd={await profileSchema(lang, 'about', title, description)}>
  <article class="container-page story">
    <a href={localePath(lang)} class="link-arrow back">
      <Icon name="arrow-left" size={16} />
      {t('story.back')}
    </a>

    <header class="story-head">
      <Picture
        src={photo}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[112, 224]}
        sizes="112px"
        loading="eager"
        fetchpriority="high"
        class="story-avatar"
      />
      <div>
        <p class="eyebrow">{site.name}</p>
        <h1 class="story-title">{t('nav.story')}</h1>
        <p class="mt-3 text-muted">{description}</p>
      </div>
    </header>

    <div class="prose-story">
      <Content />
    </div>
  </article>
</Base>

<style>
  .story {
    max-width: 46rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  .back :global(svg) {
    transition: transform 0.25s;
  }
  .back:hover :global(svg) {
    transform: translateX(-4px);
  }
  .story-head {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .story-head :global(.story-avatar) {
    flex: none;
    width: 6.5rem;
    height: 6.5rem;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: 50%;
    border: 3px solid var(--surface-strong);
    background: var(--accent-soft);
    box-shadow: 0 8px 24px -10px var(--shadow);
  }
  .story-title {
    margin-top: 0.25rem;
    font-size: clamp(2.4rem, 7vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .prose-story {
    margin-top: 3.5rem;
    font-size: 1.075rem;
    line-height: 1.8;
    color: var(--muted);
  }
  .prose-story :global(h2) {
    position: relative;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .prose-story :global(h2::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    bottom: 0.3em;
    width: 4px;
    border-radius: 4px;
    background: var(--accent);
  }
  .prose-story :global(p + p),
  .prose-story :global(ol + p) {
    margin-top: 1rem;
  }
  .prose-story :global(ol) {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
    counter-reset: item;
  }
  .prose-story :global(ol li) {
    position: relative;
    padding-left: 2.6rem;
    counter-increment: item;
  }
  .prose-story :global(ol li::before) {
    content: counter(item);
    position: absolute;
    left: 0;
    top: 0.2em;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
  }
  .prose-story :global(ol strong) {
    color: var(--fg);
  }
  .prose-story :global(em) {
    display: block;
    margin-top: 3rem;
    font-size: 0.9rem;
    color: #c2410c;
  }
  :global(:root[data-theme='dark']) .prose-story :global(em) {
    color: #fdba74;
  }
</style>
